{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./resume.schema.json",
  "title": "Kushal — resume schema",
  "description": "the shape of a person, machine-readable. contact.env is the human-readable edition.",
  "type": "object",
  "required": ["person", "experience"],
  "properties": {
    "person": {
      "type": "object",
      "required": ["name", "hireable"],
      "properties": {
        "name": { "type": "string" },
        "hireable": { "const": true, "description": "no other value parses" }
      }
    },
    "experience": {
      "type": "array",
      "minItems": 1,
      "description": "grows monotonically, unlike sleep"
    }
  },
  "additionalProperties": true,
  "$comment": "schema is fake, the hireability is real"
}
